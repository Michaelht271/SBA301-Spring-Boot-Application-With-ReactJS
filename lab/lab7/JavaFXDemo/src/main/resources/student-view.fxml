<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #F0F2F5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sba301.fe.javafxdemo.StudentController">
    <Pane prefHeight="100.0" style="-fx-background-color: #2D75E8;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <VBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="20.0">
            <Label text="STUDENT MANAGEMENT" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="30.0" />
                </font>
            </Label>
            <Label text="Internal student information management system" textFill="WHITE" />
        </VBox>
    </Pane>

    <HBox layoutX="20.0" layoutY="120.0" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="120.0">
        <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-padding: 20;">
            <Label text="Student Information" textFill="#2d75e8">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>

            <VBox spacing="5.0">
                <Label text="Email" />
                <TextField fx:id="txtEmail" prefHeight="35.0" promptText="name@example.com" />
            </VBox>

            <VBox spacing="5.0">
                <Label text="Password" />
                <TextField fx:id="txtPassword" prefHeight="35.0" />
            </VBox>

            <HBox spacing="10.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="First Name" />
                    <TextField fx:id="txtFirstName" prefHeight="35.0" />
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Last Name" />
                    <TextField fx:id="txtLastName" prefHeight="35.0" />
                </VBox>
            </HBox>

            <VBox spacing="5.0">
                <Label text="Total Mark" />
                <TextField fx:id="txtTotalMark" prefHeight="35.0" />
            </VBox>

            <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                <children>
                    <Button fx:id="btnAdd" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addStudent" prefHeight="40.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="ADD NEW" />
                    <HBox spacing="10.0">
                        <children>
                            <Button fx:id="btnUpdate" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#updateStudent" prefHeight="40.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="UPDATE" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnDelete" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#deleteStudent" prefHeight="40.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="DELETE" HBox.hgrow="ALWAYS" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </VBox>

        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-padding: 15;" HBox.hgrow="ALWAYS">
            <children>
                <Label text="List of Students " textFill="#2d75e8">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <TableView fx:id="tbData" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="studentId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="email" prefWidth="150.0" text="Email" />
                        <TableColumn fx:id="firstName" prefWidth="100.0" text="First Name" />
                        <TableColumn fx:id="lastName" prefWidth="100.0" text="Last Name" />
                        <TableColumn fx:id="totalMark" prefWidth="80.0" text="Marks" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </HBox>
</AnchorPane>
